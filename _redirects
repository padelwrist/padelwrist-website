# Serve the full PadelWrist dotted-P mark everywhere the legacy raster icon is requested.
/assets/padelwrist-mark.png /assets/padelwrist-mark-v2.svg 302
/favicon.png /assets/padelwrist-mark-v2.svg 302
/favicon.ico /assets/padelwrist-mark-v2.svg 302

# Canonicalise common index-file variants to the public trailing-slash URLs.
/index / 301
/index.html / 301
/index.php / 301
/*/index /:splat/ 301
/*/index.html /:splat/ 301
/*/index.php /:splat/ 301

# Browser fallback for time-limited PadelWrist invitations.
# Workers Static Assets supports 200 proxy routes without changing the URL.
# Keep /event/* distinct from the permanent /events/ marketing page.
/event/* /join-event/index.html 200
/match/* /join-match/index.html 200
