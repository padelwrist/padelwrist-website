# Apple Universal Links require application/json, HTTPS and a direct HTTP 200.
# These rules apply to the Workers Static Assets responses, not dynamic Workers.
/.well-known/apple-app-site-association
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300

/apple-app-site-association
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300

# Invite URLs are transient tokens. Do not index or expose them in referrers.
/event/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/match/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/join-event/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/join-match/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
